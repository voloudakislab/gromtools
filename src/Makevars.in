## Use C++17
CXX_STD = CXX17

## ---- Paths to plink2 tree ----
PLINK2_ROOT = @PLINK2_ROOT@
PGENPIC     = $(PLINK2_ROOT)/pic_min

## ---- MKL root (hardcoded as before) ----
MKLROOT = /hpc/packages/minerva-rocky9/oneAPI/2025.0.1.46/toolkits/mkl/2025.0

## ---- Include paths ----
##  ../inst/include : your RPgenReader.h, pvar_grom.h, etc.
##  PLINK2_ROOT*    : plink2/pgenlib + bundled deps
##  MKLROOT/include : for cblas.h / mkl.h
INCL = -I../inst/include \
       -I$(PLINK2_ROOT) \
       -I$(PLINK2_ROOT)/include \
       -I$(PLINK2_ROOT)/libdeflate \
       -I$(PLINK2_ROOT)/zstd/lib \
       -I$(PLINK2_ROOT)/simde \
       -I$(MKLROOT)/include

PKG_CPPFLAGS = $(INCL) \
               -DNO_UNALIGNED -DPGENLIB_NOPRINT \
               $(SHLIB_OPENMP_CXXFLAGS)

PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)

## ---- Link against plink2's PIC objs + MKL ----
PKG_LIBS = \
  $(BLAS_LIBS) $(LAPACK_LIBS) $(FLIBS) \
  $(PGENPIC)/plink2_base.o \
  $(PGENPIC)/plink2_bits.o \
  $(PGENPIC)/plink2_bgzf.o \
  $(PGENPIC)/plink2_htable.o \
  $(PGENPIC)/plink2_memory.o \
  $(PGENPIC)/plink2_string.o \
  $(PGENPIC)/plink2_text.o \
  $(PGENPIC)/plink2_thread.o \
  $(PGENPIC)/plink2_zstfile.o \
  $(PGENPIC)/pgenlib_misc.o \
  $(PGENPIC)/pgenlib_read.o \
  $(PGENPIC)/pgenlib_ffi_support.o \
  $(PGENPIC)/pvar.o \
  $(PGENPIC)/pvar_ffi_support.o \
  $(PGENPIC)/adler32.o \
  $(PGENPIC)/crc32.o \
  $(PGENPIC)/deflate_compress.o \
  $(PGENPIC)/deflate_decompress.o \
  $(PGENPIC)/zlib_compress.o \
  $(PGENPIC)/zlib_decompress.o \
  $(PGENPIC)/utils.o \
  $(PGENPIC)/arm_cpu_features.o \
  $(PGENPIC)/x86_cpu_features.o \
  -L$(MKLROOT)/lib -lmkl_rt -lpthread -lm -ldl \
  -lzstd -lz \
  $(SHLIB_OPENMP_CXXFLAGS)

## ---- Your own C++ objects ----
OBJECTS = RcppExports.o SoA_grex_v7_v7.o RPgenReader.o

.PHONY: all
all: $(SHLIB)

$(SHLIB): $(OBJECTS)
